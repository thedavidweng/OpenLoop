#!/usr/bin/env bash
# Pre-push gate: enforce patch coverage threshold before pushing.
#
# This mirrors the Codecov patch coverage check from CI (codecov.yml:
# patch target 80%). Run `pnpm coverage:patch` manually to check
# without pushing, or `git push --no-verify` to bypass.

set -euo pipefail

# Only run on feature branches — skip on main/master pushes
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  exit 0
fi

echo "pre-push: checking patch coverage (threshold: 80%)..."
echo ""

# Run the patch coverage check against main
if ! node scripts/check-patch-coverage.mjs --base main; then
  echo ""
  echo "pre-push: BLOCKED — patch coverage below threshold."
  echo "  Fix: add tests for uncovered lines"
  echo "  Bypass: git push --no-verify"
  exit 1
fi

exit 0
