{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "node_modules",
    "docs",
    "native/.build",
    "native/dist",
    "native/binaries",
    "native/Assets",
    "**/*.toml",
    "**/*.md"
  ]
}
