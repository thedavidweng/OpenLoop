{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenLoop native CLI event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "kind",
    "data"
  ],
  "properties": {
    "v": {
      "const": 2
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "lifecycle",
        "progress",
        "result",
        "error"
      ]
    },
    "data": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progress"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "fraction",
              "label"
            ],
            "properties": {
              "fraction": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
