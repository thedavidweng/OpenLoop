{
  "name": "openloop",
  "version": "0.2.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm version:sync && vite",
    "build": "pnpm version:sync && tsc && vite build",
    "preview": "vite preview",
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src/ tests/ --deny-warnings",
    "test": "vitest",
    "test:run": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=1",
    "coverage:patch": "node scripts/check-patch-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "pnpm version:sync && tauri",
    "release:check": "swift build --package-path native -Xswiftc -warnings-as-errors && swift test --package-path native -Xswiftc -warnings-as-errors && node scripts/validate-readme.mjs && node scripts/validate-release-notes.mjs && node scripts/check-cla.test.cjs",
    "release:build": "pnpm prepare:sidecars && python3 native/scripts/package-app.py --uv src-tauri/binaries/uv-aarch64-apple-darwin --dmg native/dist/OpenLoop.dmg && python3 native/scripts/smoke-cli.py",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "validate:readme": "node scripts/validate-readme.mjs",
    "validate:release-notes": "node scripts/validate-release-notes.mjs",
    "validate:docs": "node scripts/validate-readme.mjs && node scripts/validate-release-notes.mjs",
    "changelog": "git cliff -o CHANGELOG.md",
    "changelog:preview": "git cliff --latest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.2"
}
