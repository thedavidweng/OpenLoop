{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLoop",
  "version": "0.1.0",
  "identifier": "com.openmusic.openloop",
  "mainBinaryName": "openloop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLoop",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#121212",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OpenMusic",
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
